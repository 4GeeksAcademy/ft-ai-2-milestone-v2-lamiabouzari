JWT_SECRET=development-only-change-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
JWT_RESET_TOKEN_EXPIRY_MINUTES=15
DATABASE_PATH=data/db.json
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
FRONTEND_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://backend:8000
# TrackFlow RAG provider and vector database (keep credentials out of version control)
OPENAI_API_KEY=
OPENAI_BASE_URL=
RAG_EMBEDDING_MODEL=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
RAG_GENERATION_MODEL=downtown-miami/openrouter/openai/gpt-6-luna
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# MCP server (mcps/) — protected by MCP Auth (mcpauth), NOT FastMCP's built-in OAuth.
# All values below must point at your real OAuth2/OIDC provider; never hardcode secrets.
MCP_AUTH_ISSUER=
MCP_AUTH_AUTHORIZATION_ENDPOINT=
MCP_AUTH_TOKEN_ENDPOINT=
MCP_AUTH_JWKS_URI=
MCP_AUTH_AUDIENCE=
MCP_AUTH_SERVER_TYPE=oauth
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8800
# Canonical public resource URI for Protected Resource Metadata (RFC 9728).
# Only needed when the public URL differs from MCP_SERVER_HOST:MCP_SERVER_PORT
# (e.g. a Codespaces forwarded URL or a reverse proxy).
MCP_RESOURCE_URL=
# Base URL of the existing TrackFlow backend (services/) that MCP tools call over HTTP.
TRACKFLOW_API_BASE_URL=http://localhost:8000
TRACKFLOW_API_TIMEOUT_SECONDS=10
# MCP client (services/ LangGraph agent, via langchain-mcp-adapters) — Streamable HTTP
# connection to the mcps/ server above. Never put a real token in this example file.
MCP_SERVER_URL=http://localhost:8800/mcp
MCP_CLIENT_ACCESS_TOKEN=
