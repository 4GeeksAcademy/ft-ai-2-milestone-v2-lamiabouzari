# Database
DATABASE_PATH=data/db.json

# Inventory database (Postgres/Supabase) — required only for /inventory/* endpoints
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres

# Redis broker and Celery result backend
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
JWT_RESET_TOKEN_EXPIRY_MINUTES=15

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Frontend URL used in password reset links
FRONTEND_BASE_URL=http://localhost:3000
# Telemetry ingestion endpoint
TELEMETRY_ENDPOINT=/telemetry/events

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
